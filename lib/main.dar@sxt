// ----------------- نماذج البيانات (Models) -----------------

class JournalEntry {
  final double amount;
  final bool isDebit; // true = له (دائن)، false = عليه (مدين)
  final String note;
  final String date;

  JournalEntry({required this.amount, required this.isDebit, required this.note, required this.date});

  Map<String, dynamic> toJson() => {'amount': amount, 'isDebit': isDebit, 'note': note, 'date': date};

  factory JournalEntry.fromJson(Map<String, dynamic> json) {
    return JournalEntry(amount: (json['amount'] as num).toDouble(), isDebit: json['isDebit'], note: json['note'], date: json['date']);
  }
}

class Account {
  final String name;
  final String phone;
  final bool isSupplier; // هل الحساب مورد؟ (لتفادي تكرار الأكواد)
  List<JournalEntry> entries = [];

  Account({required this.name, required this.phone, required this.isSupplier});

  double get balance {
    double total = 0.0;
    for (var entry in entries) {
      if (entry.isDebit) {
        total += entry.amount;
      } else {
        total -= entry.amount;
      }
    }
    return total;
  }

  Map<String, dynamic> toJson() => {'name': name, 'phone': phone, 'isSupplier': isSupplier, 'entries': entries.map((e) => e.toJson()).toList()};

  factory Account.fromJson(Map<String, dynamic> json) {
    var acc = Account(name: json['name'], phone: json['phone'], isSupplier: json['isSupplier'] ?? false);
    if (json['entries'] != null) {
      acc.entries = (json['entries'] as List).map((e) => JournalEntry.fromJson(e)).toList();
    }
    return acc;
  }
}

class Employee {
  final String name;
  final String phone;
  final double baseSalary;
  List<JournalEntry> entries = [];

  Employee({required this.name, required this.phone, required this.baseSalary});

  double get totalPaid {
    double total = 0.0;
    for (var entry in entries) {
      if (!entry.isDebit) total += entry.amount;
    }
    return total;
  }

  double get totalReceived {
    double total = 0.0;
    for (var entry in entries) {
      if (entry.isDebit) total += entry.amount;
    }
    return total;
  }

  double get remainingSalary => baseSalary - totalPaid + totalReceived;

  Map<String, dynamic> toJson() => {'name': name, 'phone': phone, 'baseSalary': baseSalary, 'entries': entries.map((e) => e.toJson()).toList()};

  factory Employee.fromJson(Map<String, dynamic> json) {
    var emp = Employee(name: json['name'], phone: json['phone'], baseSalary: (json['baseSalary'] as num).toDouble());
    if (json['entries'] != null) {
      emp.entries = (json['entries'] as List).map((e) => JournalEntry.fromJson(e)).toList();
    }
    return emp;
  }
}

class Expense {
  final double amount;
  final String category;
  final String note;
  final String date;

  Expense({required this.amount, required this.category, required this.note, required this.date});

  Map<String, dynamic> toJson() => {'amount': amount, 'category': category, 'note': note, 'date': date};

  factory Expense.fromJson(Map<String, dynamic> json) {
    return Expense(amount: (json['amount'] as num).toDouble(), category: json['category'], note: json['note'], date: json['date']);
  }
}

class InventoryItem {
  final String name;
  int qtyInSubUnits;
  final String majorUnitName;
  final String minorUnitName;
  final int conversionRate;
  final double buyPriceMajor;
  final double sellPriceMajor;
  List<String> logs = [];

  InventoryItem({required this.name, required this.qtyInSubUnits, required this.majorUnitName, required this.minorUnitName, required this.conversionRate, required this.buyPriceMajor, required this.sellPriceMajor});

  double get majorQty => qtyInSubUnits / conversionRate;

  Map<String, dynamic> toJson() => {
    'name': name, 'qtyInSubUnits': qtyInSubUnits, 'majorUnitName': majorUnitName, 'minorUnitName': minorUnitName, 'conversionRate': conversionRate, 'buyPriceMajor': buyPriceMajor, 'sellPriceMajor': sellPriceMajor, 'logs': logs
  };

  factory InventoryItem.fromJson(Map<String, dynamic> json) {
    var item = InventoryItem(name: json['name'], qtyInSubUnits: json['qtyInSubUnits'], majorUnitName: json['majorUnitName'], minorUnitName: json['minorUnitName'], conversionRate: json['conversionRate'], buyPriceMajor: (json['buyPriceMajor'] as num).toDouble(), sellPriceMajor: (json['sellPriceMajor'] as num).toDouble());
    if (json['logs'] != null) item.logs = List<String>.from(json['logs']);
    return item;
  }
}

class Warehouse {
  final String name;
  List<InventoryItem> items = [];

  Warehouse({required this.name});

  Map<String, dynamic> toJson() => {'name': name, 'items': items.map((i) => i.toJson()).toList()};

  factory Warehouse.fromJson(Map<String, dynamic> json) {
    var wh = Warehouse(name: json['name']);
    if (json['items'] != null) wh.items = (json['items'] as List).map((i) => InventoryItem.fromJson(i)).toList();
    return wh;
  }
}

