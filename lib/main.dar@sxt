// 7. واجهة التقارير المالية المتكاملة
class FinancialReportsPage extends StatelessWidget {
  final List<Account> customers;
  final List<Account> suppliers;
  final List<Expense> expenses;
  final double profit;

  FinancialReportsPage({required this.customers, required this.suppliers, required this.expenses, required this.profit});

  @override
  Widget build(BuildContext context) {
    return DefaultTabController(
      length: 3,
      child: Scaffold(
        backgroundColor: Color(0xFF0B132B),
        appBar: AppBar(
          title: Text('التقارير المالية ودفتر اليومية'),
          bottom: TabBar(
            indicatorColor: Color(0xFF6FFFE9),
            tabs: [
              Tab(text: 'حركة الصندوق'),
              Tab(text: 'ميزان المراجعة'),
              Tab(text: 'الأرباح والخسائر'),
            ],
          ),
        ),
        body: TabBarView(
          children: [
            _buildCashflowView(),
            _buildTrialBalanceView(),
            _buildProfitLossView(),
          ],
        ),
      ),
    );
  }

  Widget _buildCashflowView() {
    List<String> logs = [];
    double balance = 0.0;

    for (var c in customers) {
      for (var e in c.entries) {
        if (e.isDebit) {
          logs.add("قبض من العميل [${c.name}]: +${e.amount} ر.ي (${e.note})");
          balance += e.amount;
        } else {
          logs.add("صرف للعميل [${c.name}]: -${e.amount} ر.ي (${e.note})");
          balance -= e.amount;
        }
      }
    }
    for (var s in suppliers) {
      for (var e in s.entries) {
        if (e.isDebit) {
          logs.add("قبض من المورد [${s.name}]: +${e.amount} ر.ي (${e.note})");
          balance += e.amount;
        } else {
          logs.add("دفع للمورد [${s.name}]: -${e.amount} ر.ي (${e.note})");
          balance -= e.amount;
        }
      }
    }
    for (var exp in expenses) {
      logs.add("مصروف عمومي [${exp.category}]: -${exp.amount} ر.ي (${exp.note})");
      balance -= exp.amount;
    }

    return Column(
      children: [
        Container(
          padding: EdgeInsets.all(15),
          color: Color(0xFF1C2541),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text('الرصيد الفعلي الحالي في الصندوق:', style: TextStyle(fontWeight: FontWeight.bold)),
              Text('$balance ر.ي', style: TextStyle(color: balance >= 0 ? Colors.greenAccent : Colors.red, fontWeight: FontWeight.bold, fontSize: 16)),
            ],
          ),
        ),
        Expanded(
          child: logs.isEmpty
              ? Center(child: Text('لا توجد حركات مالية مسجلة في الصندوق.'))
              : ListView.builder(
                  itemCount: logs.length,
                  itemBuilder: (context, index) => ListTile(
                    leading: Icon(logs[index].contains('+') ? Icons.add_circle : Icons.remove_circle, color: logs[index].contains('+') ? Colors.green : Colors.red),
                    title: Text(logs[index], style: TextStyle(fontSize: 13)),
                  ),
                ),
        )
      ],
    );
  }

  Widget _buildTrialBalanceView() {
    double totalDebit = 0.0;
    double totalCredit = 0.0;

    for (var c in customers) {
      if (c.balance < 0) totalDebit += c.balance.abs();
      if (c.balance > 0) totalCredit += c.balance;
    }
    for (var s in suppliers) {
      if (s.balance < 0) totalDebit += s.balance.abs();
      if (s.balance > 0) totalCredit += s.balance;
    }

    return Padding(
      padding: const EdgeInsets.all(20.0),
      child: Column(
        children: [
          Text('ميزان المراجعة العام للحسابات', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: Colors.tealAccent)),
          SizedBox(height: 30),
          _buildBalanceRow('إجمالي أرصدة المدين (المطالبات/الديون لنا)', '$totalDebit ر.ي', Colors.greenAccent),
          Divider(color: Colors.white24),
          _buildBalanceRow('إجمالي أرصدة الدائن (المستحقات للناس)', '$totalCredit ر.ي', Colors.redAccent),
          Divider(color: Colors.white24),
          SizedBox(height: 20),
          Text(
            totalDebit == totalCredit ? "ميزان الحسابات متوازن تماماً" : "توجد فروقات أرصدة معلقة بقيمة ${(totalDebit - totalCredit).abs()} ر.ي",
            style: TextStyle(color: totalDebit == totalCredit ? Colors.tealAccent : Colors.orangeAccent, fontWeight: FontWeight.bold),
          )
        ],
      ),
    );
  }

  Widget _buildBalanceRow(String label, String val, Color col) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 10.0),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(label, style: TextStyle(fontSize: 14)),
          Text(val, style: TextStyle(color: col, fontWeight: FontWeight.bold, fontSize: 16)),
        ],
      ),
    );
  }

  Widget _buildProfitLossView() {
    return Padding(
      padding: const EdgeInsets.all(20.0),
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(Icons.pie_chart, size: 80, color: profit >= 0 ? Colors.tealAccent : Colors.red),
          SizedBox(height: 20),
          Text('ملخص الأرباح والخسائر التشغيلية:', style: TextStyle(fontSize: 16)),
          SizedBox(height: 10),
          Text('$profit ر.ي', style: TextStyle(fontSize: 28, fontWeight: FontWeight.bold, color: profit >= 0 ? Colors.tealAccent : Colors.red)),
          SizedBox(height: 20),
          Text(
            profit >= 0 ? "أداء مالي إيجابي - مبيعاتك تتجاوز نفقاتك العامة." : "تنبيه: نفقاتك ومصروفاتك تتجاوز إيراداتك الحالية.",
            textAlign: TextAlign.center,
            style: TextStyle(color: Colors.white54, fontSize: 13),
          )
        ],
      ),
    );
  }
}

class MarqueeBar extends StatefulWidget {
  @override
  _MarqueeBarState createState() => _MarqueeBarState();
}

class _MarqueeBarState extends State<MarqueeBar> {
  late ScrollController _controller;

  @override
  void initState() {
    super.initState();
    _controller = ScrollController();
    WidgetsBinding.instance.addPostFrameCallback((_) => _startScroll());
  }

  void _startScroll() async {
    while (_controller.hasClients) {
      await Future.delayed(Duration(seconds: 1));
      if (_controller.hasClients) {
        await _controller.animateTo(
          _controller.position.maxScrollExtent,
          duration: Duration(seconds: 12),
          curve: Curves.linear,
        );
        if (_controller.hasClients) {
          await _controller.animateTo(0, duration: Duration(milliseconds: 1), curve: Curves.linear);
        }
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return Container(
      color: Color(0xFF1C2541),
      height: 32,
      child: SingleChildScrollView(
        controller: _controller,
        scrollDirection: Axis.horizontal,
        child: Row(
          children: [
            SizedBox(width: 300),
            Text(
              "📊 نظام المحاسب المالي لإدارة الديون والقيود | للتفعيل تواصل معنا: +967736666007 📊",
              style: TextStyle(color: Color(0xFF6FFFE9), fontWeight: FontWeight.bold, fontSize: 13),
            ),
            SizedBox(width: 300),
          ],
        ),
      ),
    );
  }
}
