class DashboardView extends StatefulWidget {
  final List<Account> customers;
  final List<Account> suppliers;
  final List<Expense> expenses;
  final List<Employee> employees;
  final int totalOps;
  final bool isAct;
  final VoidCallback onAction;
  final Widget Function(BuildContext) buildDrawer;
  final List<String> customModules;
  final VoidCallback onAddModule;
  final VoidCallback onUpdate;
  final bool Function() checkAccess;
  final bool isArabic;
  final String shopName;
  final String shopPhone;

  DashboardView({required this.customers, required this.suppliers, required this.expenses, required this.employees, required this.totalOps, required this.isAct, required this.onAction, required this.buildDrawer, required this.customModules, required this.onAddModule, required this.onUpdate, required this.checkAccess, required this.isArabic, required this.shopName, required this.shopPhone});

  @override
  _DashboardViewState createState() => _DashboardViewState();
}

class _DashboardViewState extends State<DashboardView> {
  String _globalSearchQuery = "";

  double get totalCustomersDebt {
    double total = 0.0;
    for (var c in widget.customers) if (c.balance < 0) total += c.balance.abs();
    return total;
  }

  double get totalSuppliersDebt {
    double total = 0.0;
    for (var s in widget.suppliers) if (s.balance > 0) total += s.balance;
    return total;
  }

  double get totalExpenses => widget.expenses.fold(0.0, (sum, item) => sum + item.amount);

  double get netProfit {
    double revenue = 0.0;
    double cost = totalExpenses;
    for (var c in widget.customers) {
      for (var e in c.entries) {
        if (e.isDebit) revenue += e.amount;
      }
    }
    for (var emp in widget.employees) {
      cost += emp.totalPaid;
    }
    return revenue - cost;
  }

  void _addQuickVoucherDialog() {
    if (!widget.checkAccess()) return;
