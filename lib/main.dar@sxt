class WarehouseDetailsPage extends StatefulWidget {
  final Warehouse warehouse;
  final VoidCallback onUpdate;
  final bool Function() checkAccess;
  final bool isArabic;

  WarehouseDetailsPage({required this.warehouse, required this.onUpdate, required this.checkAccess, required this.isArabic});

  @override
  _WarehouseDetailsPageState createState() => _WarehouseDetailsPageState();
}

class _WarehouseDetailsPageState extends State<WarehouseDetailsPage> {
  final TextEditingController _itemNameController = TextEditingController();
  final TextEditingController _itemQtyController = TextEditingController();
  final TextEditingController _itemBuyPriceController = TextEditingController();
  final TextEditingController _itemSellPriceController = TextEditingController();
  final TextEditingController _majorUnitController = TextEditingController(text: 'كرتون');
  final TextEditingController _minorUnitController = TextEditingController(text: 'علبة');
  final TextEditingController _conversionController = TextEditingController(text: '24');

  void _addItem() {
    if (!widget.checkAccess()) return;
    bool isAr = widget.isArabic;
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        backgroundColor: Color(0xFF1C2541),
        title: Text(isAr ? 'إضافة صنف جديد للمخزن' : 'Add New Item'),
        content: SingleChildScrollView(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              TextField(controller: _itemNameController, decoration: InputDecoration(labelText: isAr ? 'اسم الصنف/المادة' : 'Item Name')),
              TextField(controller: _majorUnitController, decoration: InputDecoration(labelText: isAr ? 'الوحدة الكبرى (كرتون)' : 'Major Unit (Box)')),
              TextField(controller: _minorUnitController, decoration: InputDecoration(labelText: isAr ? 'الوحدة الصغرى (علبة)' : 'Minor Unit (Piece)')),
              TextField(controller: _conversionController, keyboardType: TextInputType.number, decoration: InputDecoration(labelText: isAr ? 'معدل التحويل (علبة في الكرتون)' : 'Conversion Rate')),
              TextField(controller: _itemQtyController, keyboardType: TextInputType.number, decoration: InputDecoration(labelText: isAr ? 'الكمية الافتتاحية' : 'Initial Qty')),
              TextField(controller: _itemBuyPriceController, keyboardType: TextInputType.number, decoration: InputDecoration(labelText: isAr ? 'سعر الشراء ر.ي' : 'Buy Price')),
              TextField(controller: _itemSellPriceController, keyboardType: TextInputType.number, decoration: InputDecoration(labelText: isAr ? 'سعر البيع ر.ي' : 'Sell Price')),
            ],
          ),
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(context), child: Text(isAr ? 'إلغاء' : 'Cancel')),
          ElevatedButton(
            onPressed: () {
              if (_itemNameController.text.trim().isEmpty) return;
              int qty = int.tryParse(_itemQtyController.text.trim()) ?? 0;
              int conv = int.tryParse(_conversionController.text.trim()) ?? 12;
              double buy = double.tryParse(_itemBuyPriceController.text.trim()) ?? 0.0;
              double sell = double.tryParse(_itemSellPriceController.text.trim()) ?? 0.0;

              setState(() {
                widget.warehouse.items.add(InventoryItem(
                  name: _itemNameController.text.trim(),
                  qtyInSubUnits: qty,
                  majorUnitName: _majorUnitController.text.trim(),
                  minorUnitName: _minorUnitController.text.trim(),
                  conversionRate: conv,
                  buyPriceMajor: buy,
                  sellPriceMajor: sell,
                ));
              });

              _itemNameController.clear();
              _itemQtyController.clear();
              _itemBuyPriceController.clear();
              _itemSellPriceController.clear();
              widget.onUpdate();
              Navigator.pop(context);
            },
            child: Text(isAr ? 'إضافة صنف' : 'Add Item'),
          ),
        ],
      ),
    );
  }

  void _addStockTransaction(InventoryItem item, bool isStockIn) {
    final TextEditingController _qtyController = TextEditingController();
    bool useMajorUnit = true;

    showDialog(
      context: context,
      builder: (context) => StatefulBuilder(
        builder: (context, setDialogState) => AlertDialog(
          backgroundColor: Color(0xFF1C2541),
          title: Text(isStockIn ? (widget.isArabic ? 'عملية توريد' : 'Stock In') : (widget.isArabic ? 'عملية صرف' : 'Stock Out'), style: TextStyle(color: isStockIn ? Colors.green : Colors.red)),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              Row(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  ChoiceChip(
                    label: Text(item.majorUnitName),
                    selected: useMajorUnit,
                    onSelected: (val) => setDialogState(() => useMajorUnit = true),
                  ),
                  SizedBox(width: 10),
                  ChoiceChip(
                    label: Text(item.minorUnitName),
                    selected: !useMajorUnit,
                    onSelected: (val) => setDialogState(() => useMajorUnit = false),
                  ),
                ],
              ),
              TextField(controller: _qtyController, keyboardType: TextInputType.number, decoration: InputDecoration(labelText: widget.isArabic ? 'الكمية المطلوبة' : 'Quantity')),
            ],
          ),
          actions: [
            TextButton(onPressed: () => Navigator.pop(context), child: Text(widget.isArabic ? 'إلغاء' : 'Cancel')),
            ElevatedButton(
              style: ElevatedButton.styleFrom(backgroundColor: isStockIn ? Colors.green : Colors.red),
              onPressed: () {
                int inputQty = int.tryParse(_qtyController.text.trim()) ?? 0;
                if (inputQty <= 0) return;

                int actualSubUnits = useMajorUnit ? (inputQty * item.conversionRate) : inputQty;

                setState(() {
                  if (isStockIn) {
                    item.qtyInSubUnits += actualSubUnits;
                    item.logs.add("توريد: +$inputQty ${useMajorUnit ? item.majorUnitName : item.minorUnitName} بتاريخ ${DateTime.now().day}/${DateTime.now().month}");
                  } else {
                    if (item.qtyInSubUnits < actualSubUnits) {
                      ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('المخزون المتوفر غير كافٍ!')));
                      return;
                    }
                    item.qtyInSubUnits -= actualSubUnits;
                    item.logs.add("صرف: -$inputQty ${useMajorUnit ? item.majorUnitName : item.minorUnitName} بتاريخ ${DateTime.now().day}/${DateTime.now().month}");
                  }
                });
                widget.onUpdate();
                Navigator.pop(context);
              },
              child: Text(widget.isArabic ? 'تأكيد' : 'Confirm'),
            ),
          ],
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    bool isAr = widget.isArabic;
    return Scaffold(
      backgroundColor: Color(0xFF0B132B),
      appBar: AppBar(title: Text('مخزن: ${widget.warehouse.name}')),
      floatingActionButton: FloatingActionButton(backgroundColor: Colors.amber[800], child: Icon(Icons.add_shopping_cart), onPressed: _addItem),
      body: widget.warehouse.items.isEmpty
          ? Center(child: Text(isAr ? 'لا توجد أصناف في هذا المخزن بعد.' : 'No items in this warehouse.'))
          : ListView.builder(
              itemCount: widget.warehouse.items.length,
              itemBuilder: (context, index) {
                var item = widget.warehouse.items[index];
                double majorPart = item.qtyInSubUnits / item.conversionRate;
                int wholeMajor = majorPart.floor();
                int remainingMinor = item.qtyInSubUnits % item.conversionRate;

                return Card(
                  color: Color(0xFF1C2541),
                  margin: EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                  child: ListTile(
                    title: Text(item.name, style: TextStyle(fontWeight: FontWeight.bold)),
                    subtitle: Text('الشراء: ${item.buyPriceMajor} ر.ي | البيع: ${item.sellPriceMajor} ر.ي\nالحركة: ${item.logs.isEmpty ? "لا يوجد حركة" : item.logs.last}'),
                    trailing: Container(
                      padding: EdgeInsets.symmetric(horizontal: 8, vertical: 6),
                      decoration: BoxDecoration(color: item.qtyInSubUnits > (item.conversionRate * 2) ? Colors.teal[900] : Colors.red[900], borderRadius: BorderRadius.circular(10)),
                      child: Text(
                        'المخزون: $wholeMajor ${item.majorUnitName} و $remainingMinor ${item.minorUnitName}',
                        style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 11),
                      ),
                    ),
                    onTap: () {
                      showModalBottomSheet(
                        backgroundColor: Color(0xFF1C2541),
                        context: context,
                        builder: (context) => Container(
                          padding: EdgeInsets.all(15),
                          height: 180,
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.stretch,
                            children: [
                              Text('تعديل مخزون الصنف: ${item.name}', textAlign: TextAlign.center, style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
                              Spacer(),
                              Row(
                                children: [
                                  Expanded(
                                    child: ElevatedButton.icon(
                                      style: ElevatedButton.styleFrom(backgroundColor: Colors.green),
                                      icon: Icon(Icons.add),
                                      label: Text('توريد مخزني'),
                                      onPressed: () {
                                        Navigator.pop(context);
                                        _addStockTransaction(item, true);
                                      },
                                    ),
                                  ),
                                  SizedBox(width: 10),
                                  Expanded(
                                    child: ElevatedButton.icon(
                                      style: ElevatedButton.styleFrom(backgroundColor: Colors.red),
                                      icon: Icon(Icons.remove),
                                      label: Text('صرف مخزني'),
                                      onPressed: () {
                                        Navigator.pop(context);
                                        _addStockTransaction(item, false);
                                      },
                                    ),
                                  ),
                                ],
                              ),
                              SizedBox(height: 10),
                            ],
                          ),
                        ),
                      );
                    },
                  ),
                );
              },
            ),
    );
  }
}

