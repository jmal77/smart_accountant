  Future<void> _saveToSharedPreferences() async {
    final SharedPreferences prefs = await SharedPreferences.getInstance();
    Map<String, dynamic> appState = {
      'isActivated': isActivated,
      'customModules': customModules,
      'shopName': shopName,
      'shopPhone': shopPhone,
      'customers': customers.map((c) => c.toJson()).toList(),
      'suppliers': suppliers.map((s) => s.toJson()).toList(),
      'employees': employees.map((e) => e.toJson()).toList(),
      'expenses': expenses.map((e) => e.toJson()).toList(),
      'warehouses': warehouses.map((w) => w.toJson()).toList(),
    };
    await prefs.setString('app_data_state_pro', json.encode(appState));
  }

  Future<void> _loadFromSharedPreferences() async {
    final SharedPreferences prefs = await SharedPreferences.getInstance();
    String? dataString = prefs.getString('app_data_state_pro');
    if (dataString != null) {
      Map<String, dynamic> appState = json.decode(dataString);
      setState(() {
        isActivated = appState['isActivated'] ?? false;
        shopName = appState['shopName'] ?? "محل جمال الصلوي التجاري";
        shopPhone = appState['shopPhone'] ?? "+967736666007";
        if (appState['customModules'] != null) customModules = List<String>.from(appState['customModules']);
        if (appState['customers'] != null) customers = (appState['customers'] as List).map((c) => Account.fromJson(c)).toList();
        if (appState['suppliers'] != null) suppliers = (appState['suppliers'] as List).map((s) => Account.fromJson(s)).toList();
        if (appState['employees'] != null) employees = (appState['employees'] as List).map((e) => Employee.fromJson(e)).toList();
        if (appState['expenses'] != null) expenses = (appState['expenses'] as List).map((e) => Expense.fromJson(e)).toList();
        if (appState['warehouses'] != null) warehouses = (appState['warehouses'] as List).map((w) => Warehouse.fromJson(w)).toList();
      });
    }
  }

  int get totalTransactionsCount {
    int count = 0;
    for (var c in customers) count += c.entries.length;
    for (var s in suppliers) count += s.entries.length;
    for (var e in employees) count += e.entries.length;
    count += expenses.length;
    return count;
  }

