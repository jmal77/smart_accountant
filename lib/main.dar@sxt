        backgroundColor: Color(0xFF1C2541),
        title: Text(isDebit ? 'إضافة مبلغ (له / دائن)' : 'إضافة مبلغ (عليه / مدين)', style: TextStyle(color: isDebit ? Colors.greenAccent : Colors.redAccent)),
